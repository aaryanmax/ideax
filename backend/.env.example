# ========================================================
# Environment Configuration Template (VAYU-CHRONICLE Core)
# Copy this file to `.env` and adjust paths for your local setup.
# ========================================================

# Optional: Central directory for storing models & weights locally.
# If left commented or blank, defaults to local project directory: `./data/models`
# LOCAL_AI_DIR=C:/Users/YourUser/Projects/LocalAi

# Hugging Face & Offline Caches (Optional)
# HF_HOME=./data/models/huggingface
# TRANSFORMERS_CACHE=./data/models/huggingface/hub
# TORCH_HOME=./data/models/torch
# HF_HUB_DISABLE_SYMLINKS_WARNING=1
# HF_TOKEN=your_huggingface_token_here
